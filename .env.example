# Liga o MSW (REST + Socket.IO simulados). Ligado por padrão em dev e no build de demonstração.
VITE_ENABLE_MOCKS=true
# Base da API REST (interceptada pelo MSW quando os mocks estão ligados)
VITE_API_URL=/api
# URL do servidor Socket.IO (interceptada pelo MSW via @mswjs/socket.io-binding)
VITE_SOCKET_URL=wss://realtime.kurio.mock
